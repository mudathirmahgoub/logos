+;-----------------------------------------------------------------------------
+(section "Bags")
+;-----------------------------------------------------------------------------
+
+; Bags.
+;
+; The symbols the SMT-LIB semantics gives a meaning to transform pointwise, but
+; for bag.empty, which is written with the type of its elements and so
+; transforms through a program of its own, as set.empty does. bag.member and
+; bag.subbag have no meaning of their own to the model: each is eliminated into
+; the symbols above, the way the bags rewriter of cvc5 eliminates them. The
+; witness @bags_deq_diff of a disequality between two bags becomes map_diff, as
+; @sets_deq_diff does.
+;
+; The other symbols of the theory (bag.card, bag.choose, bag.is_singleton,
+; bag.filter, bag.map, bag.fold, the table operators and the remaining skolems)
+; are not given a meaning here, so a proof that mentions them is outside the
+; specified fragment.
+
+(program $eo_to_smt_bag.empty ((T SmtType))
+  :signature (SmtType) SmtTerm
+  (
+  (($eo_to_smt_bag.empty (Bag T)) (bag.empty T))
+  (($eo_to_smt_bag.empty T) none)
+  )
+)
+
+(program $eo_to_smt_bag_elem_type ((T SmtType))
+  :signature (SmtType) SmtType
+  (
+  (($eo_to_smt_bag_elem_type (Bag T)) T)
+  (($eo_to_smt_bag_elem_type T) none)
+  )
+)
+
+(define-symbol bag.empty ((! t :type))
+  :term ($eo_to_smt_bag.empty t))
+
+(define-symbol bag (x c))
+
+(define-symbol bag.count (x a))
+
+(define-symbol bag.union_disjoint (a b))
+
+(define-symbol bag.union_max (a b))
+
+(define-symbol bag.inter_min (a b))
+
+(define-symbol bag.difference_subtract (a b))
+
+(define-symbol bag.difference_remove (a b))
+
+(define-symbol bag.setof (a))
+
+; The symbols below have no meaning of their own to the model: each is
+; eliminated on the way to the SMT-LIB signature.
+
+; -- bag.member
+(define-symbol bag.member (x a)
+  :term (>= (bag.count x a) 1))
 
+; -- bag.subbag
+(define-symbol bag.subbag (a b)
+  :term (= (bag.difference_subtract a b)
+           (bag.empty ($eo_to_smt_bag_elem_type (smt.typeof a)))))
+
+; -- @bags_deq_diff
+(program $eo_to_smt_bags_deq_diff
+  ((a SmtTerm) (aT SmtType) (b SmtTerm) (bT SmtType))
+  :signature (SmtTerm SmtType SmtTerm SmtType) SmtTerm
+  (
+  (($eo_to_smt_bags_deq_diff a (Bag aT) b (Bag bT)) (map_diff a b))
+  (($eo_to_smt_bags_deq_diff a aT b bT) none)
+  )
+)
+(define-symbol @bags_deq_diff (a b)
+  :term ($eo_to_smt_bags_deq_diff a (smt.typeof a) b (smt.typeof b)))
+
