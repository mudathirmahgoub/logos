+  :typeof ($smtx_map_to_bag_type ($smtx_typeof_map_value m))
+  :canonical ("and" ($smtx_map_canonical uc m)
+               ("and" ("veq" ($smtx_map_get_default m) (smt.numeral 0))
+                 ($smtx_bag_counts_pos m))))
