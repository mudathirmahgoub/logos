+; -- $smtx_map_to_bag_type
+; A bag is a mapping to its multiplicities, so the type of one is read off the
+; map it is.
+(program $smtx_map_to_bag_type ((T SmtType))
+  :signature (SmtType) SmtType
+  (
+  (($smtx_map_to_bag_type (Map T Int)) (Bag T))
+  (($smtx_map_to_bag_type T) none)
+  )
+)
+
+; A bag is a map to the multiplicities of its elements, which are unbounded, so
+; it is neither unit nor finite, even over a finite type.
+(define-sort Bag (T)
+  :wf ($smtx_type_wf_component_rec T)
+  :bounded "false"
+  :default (smt.bag (smt.map_empty_bag T)))
 
