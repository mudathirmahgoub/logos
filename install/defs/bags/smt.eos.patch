+; -- $smtx_bag_counts_pos
+; Whether every multiplicity a map stores is a positive numeral.
+(program $smtx_bag_counts_pos
+  ((T SmtType) (i SmtValue) (e SmtValue) (d SmtValue) (n <numeral>) (m SmtMap))
+  :signature (SmtMap) <bool>
+  (
+  (($smtx_bag_counts_pos ($msm_default T d)) "true")
+  (($smtx_bag_counts_pos ($msm_cons i (smt.numeral n) m))
+    ("and" ("zlt" 0 n) ($smtx_bag_counts_pos m)))
+  (($smtx_bag_counts_pos ($msm_cons i e m)) "false")
+  )
+)
+
+; A bag is a map to the multiplicities of its elements, so it is canonical when
