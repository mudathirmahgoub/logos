+;-----------------------------------------------------------------------------
+(section "Bags")
+;-----------------------------------------------------------------------------
+
+; Bags.
+;
+; A bag is a map from its elements to their multiplicities, which are positive
+; numerals, and it maps everything else to zero. Every operator that builds a
+; bag from two others is computed pointwise, from the multiplicities an
+; element has in its arguments, by the program $smtx_bag_combine, so they all
+; share one walk over the maps, $smtx_bag_op_rec. The programs and the type
+; rules the symbols name come first.
+
+; The multiplicity a value of a bag stands for: the numeral it is, and zero for
+; anything else, which no canonical bag stores.
+(program $smtx_bag_mult ((n <numeral>) (v SmtValue))
+  :signature (SmtValue) <numeral>
+  (
+  (($smtx_bag_mult (smt.numeral n)) n)
+  (($smtx_bag_mult v) 0)
+  )
+)
+
+; The multiplicity an element has in the result of the operator named by k,
+; given the multiplicities c1 and c2 it has in the arguments:
+;   0  bag.union_disjoint      c1 + c2
+;   1  bag.union_max           max(c1, c2)
+;   2  bag.inter_min           min(c1, c2)
+;   3  bag.difference_subtract c1 - c2 if c1 >= c2, and 0 otherwise
+;   4  bag.difference_remove   c1 if c2 <= 0, and 0 otherwise
+;   5  bag.setof               1 if c1 >= 1, and 0 otherwise
+; Each is zero when both multiplicities are zero, which is what makes a walk
+; over the elements stored in the arguments enough.
+(program $smtx_bag_combine ((k <numeral>) (c1 <numeral>) (c2 <numeral>))
+  :signature (<numeral> <numeral> <numeral>) <numeral>
+  (
+  (($smtx_bag_combine k c1 c2)
+    ("ite" ("zeq" k 0) ("zplus" c1 c2)
+    ("ite" ("zeq" k 1) ("ite" ("zlt" c2 c1) c1 c2)
+    ("ite" ("zeq" k 2) ("ite" ("zlt" c1 c2) c1 c2)
+    ("ite" ("zeq" k 3) ("ite" ("zleq" c2 c1) ("zplus" c1 ("zneg" c2)) 0)
+    ("ite" ("zeq" k 4) ("ite" ("zleq" c2 0) c1 0)
+      ("ite" ("zleq" 1 c1) 1 0)))))))
+  )
+)
+
+; The walk: for each element stored in m, set its multiplicity in acc to the
+; one the operator k gives it from m1 and m2.
+(program $smtx_bag_op_rec
+  ((k <numeral>) (T SmtType) (d SmtValue) (e SmtValue) (c SmtValue)
+   (m SmtMap) (m1 SmtMap) (m2 SmtMap) (acc SmtMap))
+  :signature (<numeral> SmtMap SmtMap SmtMap SmtMap) SmtMap
+  (
+  (($smtx_bag_op_rec k ($msm_default T d) m1 m2 acc) acc)
+  (($smtx_bag_op_rec k ($msm_cons e c m) m1 m2 acc)
+    ($smtx_bag_op_rec k m m1 m2
+      (smt.map_update acc e
+        (smt.numeral ($smtx_bag_combine k
+          ($smtx_bag_mult ($smtx_map_lookup m1 e))
+          ($smtx_bag_mult ($smtx_map_lookup m2 e)))))))
+  )
+)
 
+; The operator named by k, applied to two bag values: the walk over the
+; elements of both, starting from the empty bag.
+(program $smtx_bag_op
+  ((k <numeral>) (m1 SmtMap) (m2 SmtMap) (v1 SmtValue) (v2 SmtValue))
+  :signature (<numeral> SmtValue SmtValue) SmtValue
+  (
+  (($smtx_bag_op k (smt.bag m1) (smt.bag m2))
+    (smt.bag ($smtx_bag_op_rec k m2 m1 m2
+      ($smtx_bag_op_rec k m1 m1 m2
+        (smt.map_empty_bag ($smtx_index_typeof_map ($smtx_typeof_map_value m1)))))))
+  (($smtx_bag_op k v1 v2) smt.not_value)
+  )
+)
+
+; The bag holding x with multiplicity c, which is empty when c is not positive.
+(program $smtx_bag_make ((x SmtValue) (n <numeral>) (v SmtValue))
+  :signature (SmtValue SmtValue) SmtValue
+  (
+  (($smtx_bag_make x (smt.numeral n))
+    ("ite" ("zlt" 0 n)
+      (smt.bag ($msm_cons x (smt.numeral n) (smt.map_empty_bag (smt.typeof_value x))))
+      (smt.bag (smt.map_empty_bag (smt.typeof_value x)))))
+  (($smtx_bag_make x v) smt.not_value)
+  )
+)
+
+; The multiplicity of x in a bag value.
+(program $smtx_bag_count ((x SmtValue) (m SmtMap) (v SmtValue))
+  :signature (SmtValue SmtValue) SmtValue
+  (
+  (($smtx_bag_count x (smt.bag m)) ($smtx_map_lookup m x))
+  (($smtx_bag_count x v) smt.not_value)
+  )
+)
+
+; The type of a bag operator whose two arguments must be bags of one type.
+(program $smtx_typeof_bags_op_2 ((x1 SmtType) (x2 SmtType))
+  :signature (SmtType SmtType) SmtType
+  (
+  (($smtx_typeof_bags_op_2 (Bag x1) (Bag x2))
+    ("ite" ("Teq" x1 x2) (Bag x1) none))
+  (($smtx_typeof_bags_op_2 x1 x2) none)
+  )
+)
+
+(program $smtx_typeof_bags_op_1 ((x1 SmtType))
+  :signature (SmtType) SmtType
+  (
+  (($smtx_typeof_bags_op_1 (Bag x1)) (Bag x1))
+  (($smtx_typeof_bags_op_1 x1) none)
+  )
+)
+
+(program $smtx_typeof_bag ((x1 SmtType) (x2 SmtType))
+  :signature (SmtType SmtType) SmtType
+  (
+  (($smtx_typeof_bag x1 Int) ($smtx_typeof_guard_wf (Bag x1) (Bag x1)))
+  (($smtx_typeof_bag x1 x2) none)
+  )
+)
+
+(program $smtx_typeof_bag.count ((x1 SmtType) (x2 SmtType) (x3 SmtType) (x4 SmtType))
+  :signature (SmtType SmtType) SmtType
+  (
+  (($smtx_typeof_bag.count x1 (Bag x2)) ("ite" ("Teq" x1 x2) Int none))
+  (($smtx_typeof_bag.count x3 x4) none)
+  )
+)
+
+(define-symbol bag.empty ((! t :type))
+  :typeof ($smtx_typeof_guard_wf (Bag t) (Bag t))
+  :value (smt.bag (smt.map_empty_bag t)))
+
+(define-symbol bag (x c)
+  :typeof ($smtx_typeof_bag x c)
+  :eval (x c) ($smtx_bag_make x c))
+
+(define-symbol bag.count (x a)
+  :typeof ($smtx_typeof_bag.count x a)
+  :eval (x a) ($smtx_bag_count x a))
+
+(define-symbol bag.union_disjoint (a b)
+  :typeof ($smtx_typeof_bags_op_2 a b)
+  :eval (a b) ($smtx_bag_op 0 a b))
+
+(define-symbol bag.union_max (a b)
+  :typeof ($smtx_typeof_bags_op_2 a b)
+  :eval (a b) ($smtx_bag_op 1 a b))
+
+(define-symbol bag.inter_min (a b)
+  :typeof ($smtx_typeof_bags_op_2 a b)
+  :eval (a b) ($smtx_bag_op 2 a b))
+
+(define-symbol bag.difference_subtract (a b)
+  :typeof ($smtx_typeof_bags_op_2 a b)
+  :eval (a b) ($smtx_bag_op 3 a b))
+
+(define-symbol bag.difference_remove (a b)
+  :typeof ($smtx_typeof_bags_op_2 a b)
+  :eval (a b) ($smtx_bag_op 4 a b))
+
+(define-symbol bag.setof (a)
+  :typeof ($smtx_typeof_bags_op_1 a)
+  :eval (a) ($smtx_bag_op 5 a a))
+
